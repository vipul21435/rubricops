# Copy to .env and adjust. Every value below is optional; defaults are safe for local use.

# dev | test | prod. In prod the app refuses to start with the default JWT secret.
RUBRICOPS_ENV=dev

# Any SQLAlchemy URL. SQLite by default; Postgres example:
# RUBRICOPS_DATABASE_URL=postgresql+psycopg://rubricops:rubricops@localhost:5432/rubricops
RUBRICOPS_DATABASE_URL=sqlite:///./var/rubricops.db

# HS256 signing key for access tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
RUBRICOPS_JWT_SECRET=change-me
RUBRICOPS_JWT_TTL_MINUTES=60

# Fraction of primary reviews routed to QA audit at random (risk-based sampling is added on top).
RUBRICOPS_QA_SAMPLE_RATE=0.10

# Hours a reviewer has to finish an assigned item before it is flagged overdue.
RUBRICOPS_REVIEW_SLA_HOURS=24

# Seed for every sampling and bootstrap RNG, so runs are reproducible.
RUBRICOPS_RANDOM_SEED=20260929
